{
  "manifest_version": 3,
  "name": "Lexicon",
  "version": "0.1.0",
  "description": "Save and semantically search everything you read.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Lexicon"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
