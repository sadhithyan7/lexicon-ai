{
  "manifest_version": 3,
  "name": "Lexicon",
  "version": "0.2.0",
  "description": "Save everything you read. Search it semantically. Get cited answers.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Lexicon"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "<all_urls>"
  ],

  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:3001/*"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Readability.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
